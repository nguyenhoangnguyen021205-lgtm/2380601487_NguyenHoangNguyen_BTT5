@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container py-5">
    <!-- Header Hero Section -->
    <div class="p-5 mb-4 bg-light rounded-3 border-start border-primary border-5 shadow-sm animate-fade-in">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-dark mb-3">Bài tập Lập trình Web</h1>
            <p class="col-md-10 fs-5 text-secondary">
                Hệ thống Quản lý Lớp học & Sách trực tuyến được xây dựng trên nền tảng <strong>ASP.NET Core MVC 8.0</strong> và <strong>Entity Framework Core</strong>.
            </p>
            <hr class="my-4">
            
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h4 class="text-primary fw-bold mb-3"><i class="bi bi-person-badge"></i> Thông tin Sinh viên</h4>
                    <table class="table table-borderless w-auto">
                        <tbody>
                            <tr>
                                <td class="fw-bold text-secondary ps-0" style="width: 150px;">Họ và tên:</td>
                                <td class="fw-bold text-dark">Nguyễn Hoàng Nguyên</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary ps-0">Mã số sinh viên (MSSV):</td>
                                <td class="text-dark font-monospace">2380601487</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary ps-0">Lớp học:</td>
                                <td class="text-dark">23DTHB4</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-secondary ps-0">Môn học:</td>
                                <td class="text-dark">Lập trình Web (Buổi 5)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-5 text-center text-md-end">
                    <span class="badge bg-success p-3 fs-6 rounded-pill shadow-sm">
                        <i class="bi bi-check-circle-fill"></i> Database Connect: Active
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Cards -->
    <div class="row g-4 mt-2">
        <!-- Card 1: Books -->
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-book-half" viewBox="0 0 16 16">
                                <path d="M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                            </svg>
                        </div>
                        <h3 class="h4 card-title mb-0 fw-bold">Quản lý Sách</h3>
                    </div>
                    <p class="card-text text-secondary mb-4 flex-grow-1">
                        Xem, thêm, sửa, xoá danh mục sách và phân loại sách theo các chủ đề như Lập trình, Cuộc sống, Sức khoẻ.
                    </p>
                    <a asp-controller="Book" asp-action="Index" class="btn btn-primary mt-auto py-2 fw-semibold">
                        Truy cập Quản lý Sách <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2: Grades -->
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-mortarboard-fill" viewBox="0 0 16 16">
                                <path d="M8.211 2.047a.5.5 0 0 0-.422 0l-7.135 3.7a.5.5 0 0 0 0 .896l1.15.596v2.544c0 .559.327 1.074.846 1.3l2.87 1.254V13.5a.5.5 0 0 0 .707.455l3.22-1.47 3.22 1.47a.5.5 0 0 0 .707-.455v-2.165l2.87-1.254c.519-.226.846-.741.846-1.3V7.24l1.15-.596a.5.5 0 0 0 0-.896l-7.135-3.7z"/>
                                <path d="M4.214 10.14A3.483 3.483 0 0 0 8 11.5a3.483 3.483 0 0 0 3.786-1.36L8 9.5l-3.786.64z"/>
                            </svg>
                        </div>
                        <h3 class="h4 card-title mb-0 fw-bold">Quản lý Lớp</h3>
                    </div>
                    <p class="card-text text-secondary mb-4 flex-grow-1">
                        Hiển thị danh sách các lớp học hiện có trong hệ thống dữ liệu học tập và thông tin học viên.
                    </p>
                    <a asp-controller="Grade" asp-action="Index" class="btn btn-success mt-auto py-2 fw-semibold">
                        Truy cập Quản lý Lớp <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
    .transition-all {
        transition: all 0.3s ease-in-out;
    }
</style>
