@model lap_trinh_web_b5.Models.Book.BookIndexViewModel

@{
    ViewData["Title"] = "Danh sách Sách";
}

<!-- Unique Styling for the Premium Index Page -->
<style>
    /* CSS Variables for curated color scheme */
    :root {
        --primary-indigo: #4f46e5;
        --secondary-emerald: #10b981;
        --dark-slate: #1e293b;
        --light-slate: #f8fafc;
        --border-slate: #e2e8f0;
    }

    /* Overall layout */
    .premium-book-page {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 32px;
        margin-top: 24px;
        animation: fadeIn 0.5s ease-out;
    }

    /* Sidebar Styling */
    .premium-sidebar {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border-slate);
        height: fit-content;
    }

    .premium-sidebar h2 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--dark-slate);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .premium-category-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .premium-category-list li {
        margin-bottom: 10px;
    }

    .premium-category-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        border-radius: 10px;
        color: #475569;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
        background: transparent;
    }

    .premium-category-item:hover {
        background: #f1f5f9;
        color: var(--primary-indigo);
    }

    .premium-category-item.active {
        background: linear-gradient(135deg, var(--primary-indigo), #6366f1);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }

    .premium-category-badge {
        background: #f1f5f9;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 30px;
        transition: all 0.2s ease;
    }

    .premium-category-item.active .premium-category-badge {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
    }

    /* Content and Toolbar Styling */
    .premium-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .premium-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #ffffff;
        padding: 16px 24px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border-slate);
    }

    .premium-toolbar h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--dark-slate);
        margin: 0;
    }

    .btn-create-premium {
        background: linear-gradient(135deg, var(--primary-indigo), #6366f1);
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        font-weight: 600;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-create-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }

    /* Books Grid Styling */
    .premium-book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 24px;
    }

    /* Premium Book Card strictly matching Slide 26 layout */
    .slide-book-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid var(--border-slate);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .slide-book-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        border-color: #cbd5e1;
    }

    /* Card Header */
    .slide-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: #f8fafc;
        border-bottom: 1px solid var(--border-slate);
    }

    .slide-card-header h3 {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--dark-slate);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 75%;
    }

    .slide-card-header .edit-link {
        color: var(--primary-indigo);
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .slide-card-header .edit-link:hover {
        color: #312e81;
        text-decoration: underline;
    }

    /* Card Body */
    .slide-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        align-items: flex-start;
    }

    .slide-meta-info {
        width: 100%;
        margin-bottom: 16px;
        font-size: 0.9rem;
        color: #475569;
        border-left: 3px solid #cbd5e1;
        padding-left: 12px;
    }

    .slide-meta-info p {
        margin: 0 0 6px;
        line-height: 1.4;
    }

    .slide-meta-info strong {
        color: #1e293b;
    }

    /* Centered Image Container */
    .slide-image-container {
        align-self: center;
        width: 130px;
        height: 180px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        border: 1px solid var(--border-slate);
        background: #f1f5f9;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
    }

    .slide-book-card:hover .slide-image-container {
        transform: scale(1.05);
    }

    .slide-image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Card Footer with Green buttons (strictly matching Slide 26 and Slide 28) */
    .slide-card-footer {
        padding: 16px 20px;
        background: #ffffff;
        border-top: 1px solid var(--border-slate);
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }

    .slide-btn-detail {
        flex: 1;
        background: transparent;
        color: var(--secondary-emerald);
        border: 1.5px solid var(--secondary-emerald);
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 8px;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .slide-btn-detail:hover {
        background: rgba(16, 185, 129, 0.05);
        color: #047857;
        border-color: #047857;
    }

    .slide-btn-delete {
        flex: 1;
        background: var(--secondary-emerald);
        color: #ffffff;
        border: none;
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 8px;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(16, 185, 129, 0.15);
    }

    .slide-btn-delete:hover {
        background: #059669;
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
    }

    /* Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 992px) {
        .premium-book-page {
            grid-template-columns: 1fr;
            gap: 24px;
        }
        .premium-sidebar {
            width: 100%;
        }
    }
</style>

<div class="premium-book-page">
    <!-- Sidebar on the Left: Retrieves Categories from CSDL and displays count of books -->
    <aside class="premium-sidebar">
        <h2>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-tag-fill" viewBox="0 0 16 16">
                <path d="M2 1a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l4.586-4.586a1 1 0 0 0 0-1.414l-7-7A1 1 0 0 0 6.586 1H2zm4 3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
            </svg>
            Chủ đề
        </h2>
        <ul class="premium-category-list">
            <li>
                <a asp-action="Index" class="premium-category-item @(Model.CurrentCategoryId == null ? "active" : "")">
                    <span>Tất cả</span>
                    <span class="premium-category-badge">@Model.Books.Count</span>
                </a>
            </li>
            @foreach (var category in Model.Categories)
            {
                <li>
                    <a asp-action="Index"
                       asp-route-categoryId="@category.CategoryId"
                       class="premium-category-item @(Model.CurrentCategoryId == category.CategoryId ? "active" : "")">
                        <span>@category.CategoryName</span>
                        <span class="premium-category-badge">@category.BookCount</span>
                    </a>
                </li>
            }
        </ul>
    </aside>

    <!-- Main Content Area -->
    <section class="premium-content">
        <!-- Toolbar with title and "Thêm sách" -->
        <div class="premium-toolbar">
            <h1>Thêm mới</h1>
            <a asp-action="Create" class="btn-create-premium">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-plus-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.5 4.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3v-3z"/>
                </svg>
                Thêm sách
            </a>
        </div>

        <!-- Books Grid containing Slide-perfect Books cards -->
        <div class="premium-book-grid">
            @foreach (var book in Model.Books)
            {
                var imagePath = string.IsNullOrWhiteSpace(book.Image)
                    ? Url.Content("~/Content/ImageBooks/no-image.jpg")
                    : Url.Content("~/Content/ImageBooks/" + book.Image);

                <!-- Card strictly styled to match slide 26 layout with title & edit in header, meta & center image in body, green buttons in footer -->
                <article class="slide-book-card">
                    <!-- Header: Title and Edit -->
                    <div class="slide-card-header">
                        <h3 title="@book.Title">@book.Title</h3>
                        <a asp-action="Edit" asp-route-id="@book.Id" class="edit-link">Edit</a>
                    </div>
                    
                    <!-- Body: Meta details + Center image -->
                    <div class="slide-card-body">
                        <div class="slide-meta-info">
                            <p><strong>Tác giả:</strong> @book.Author</p>
                            <p><strong>Thể loại:</strong> @book.Category?.CategoryName</p>
                            <p><strong>Đơn giá:</strong> <span class="text-danger fw-semibold">@book.Price.ToString("N0") VND</span></p>
                        </div>
                        
                        <!-- Image centered -->
                        <div class="slide-image-container">
                            <img src="@imagePath" alt="@book.Title" loading="lazy" />
                        </div>
                    </div>
                    
                    <!-- Footer: Chi tiết and Xóa (Green matching slide 26) -->
                    <div class="slide-card-footer">
                        <a asp-action="Details" asp-route-id="@book.Id" class="slide-btn-detail">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@book.Id" class="slide-btn-delete">Xóa</a>
                    </div>
                </article>
            }
        </div>
    </section>
</div>
